---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { profileByLocale } from '../data/profile';

interface Props {
  locale: 'id' | 'en';
  currentPage?: 'home' | 'resume' | 'blog';
  languageHref?: string;
}

const { locale, currentPage = 'home', languageHref: languageHrefOverride } = Astro.props;
const isId = locale === 'id';
const targetLocale = isId ? 'en' : 'id';
const profile = profileByLocale[locale];
const homeHref = getRelativeLocaleUrl(locale);
const resumeHref = getRelativeLocaleUrl(locale, 'resume');
const blogHref = getRelativeLocaleUrl(locale, 'blog');
const languageHref = languageHrefOverride ?? getRelativeLocaleUrl(targetLocale, currentPage === 'resume' ? 'resume' : currentPage === 'blog' ? 'blog' : '');
---

<a class="skip-link" href="#main">{isId ? 'Lewati ke konten' : 'Skip to content'}</a>
<nav class="contact-bar" aria-label={isId ? 'Kontak' : 'Contact'}>
  <a class="contact-link" href="mailto:arielfebrian98@gmail.com">
    <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.7" />
      <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>arielfebrian98@gmail.com</span>
  </a>
  <a class="contact-link" href="https://wa.me/6281261019043" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp +62 812-6101-9043">
    <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M9 8.5c.3 2.8 2.4 4.8 5.3 5.5l1.1-1.1-2-.9-1 1c-1.2-.4-2.1-1.3-2.5-2.5l.7-.9-1-1.8Z" fill="currentColor" />
    </svg>
    <span>+62 812-6101-9043</span>
  </a>
  {profile.socialLinks.map((link) => (
    <a class="social-link" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
      {link.label === 'GitHub' ? (
        <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 .297a12 12 0 0 0-3.8 23.38c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.62-2.8 5.64-5.48 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .297Z" />
        </svg>
      ) : (
        <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="2" y="2" width="20" height="20" rx="2" fill="currentColor" />
          <circle cx="7.2" cy="7.2" r="1.25" fill="white" />
          <path fill="white" d="M6 10h2.4v8H6zm4 0h2.3v1.1c.45-.76 1.22-1.3 2.5-1.3 2.67 0 3.2 1.76 3.2 4.05V18h-2.5v-3.7c0-1.22-.02-2.8-1.7-2.8-1.72 0-1.98 1.34-1.98 2.71V18H10z" />
        </svg>
      )}
      <span>{link.label}</span>
    </a>
  ))}
</nav>
<header class="site-header">
  <a class="wordmark" href={homeHref}>{profile.name ?? (isId ? 'Portofolio' : 'Portfolio')}</a>
  <div class="header-tools">
    <nav class="primary-nav" aria-label={isId ? 'Navigasi utama' : 'Main navigation'}>
      <a href={homeHref} aria-current={currentPage === 'home' ? 'page' : undefined}>{isId ? 'Beranda' : 'Home'}</a>
      <a href={resumeHref} aria-current={currentPage === 'resume' ? 'page' : undefined}>Resume</a>
      <a href={blogHref} aria-current={currentPage === 'blog' ? 'page' : undefined}>{isId ? 'Tulisan' : 'Writing'}</a>
    </nav>
    <LanguageSwitcher locale={locale} targetHref={languageHref} />
  </div>
</header>
