---
import '../styles/global.css';
import { profileByLocale } from '../data/profile';

interface Props {
  title: string;
  description: string;
  locale: 'id' | 'en';
  canonicalUrl: string;
  noIndex?: boolean;
}

const { title, description, locale, canonicalUrl, noIndex = false } = Astro.props;
const canonical = !noIndex && Astro.site ? new URL(canonicalUrl, Astro.site) : undefined;
const profile = profileByLocale[locale];
const sampleNotice = locale === 'id'
  ? 'Data resume ini hanya contoh fiktif. Ganti dengan informasi Anda sebelum situs dipublikasikan.'
  : 'This resume contains fictional sample data. Replace it with your information before publishing.';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon-af.png`} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    {profile.isSample && <aside class="site-sample-banner" role="note">{sampleNotice}</aside>}
    <slot />
  </body>
</html>
